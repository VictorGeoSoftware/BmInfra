# Copy to local-qa.env and replace every placeholder. The real file is ignored.

# Local QA database and backend data encryption. Keep the encryption key stable
# for as long as you retain the local-qa-postgres volume.
DB_PASSWORD=replace-with-a-local-password
BM_ENCRYPTION_KEY=replace-with-base64-of-32-bytes

# AI price extraction.
GEMINI_API_KEY=replace-with-gemini-api-key
# GEMINI_MODEL=gemini-3.7-flash
# PRICE_AGENT_MAX_CONCURRENCY=5

# QA n8n login and persistent credential encryption.
N8N_QA_PASSWORD=replace-with-a-local-password
N8N_ENCRYPTION_KEY=replace-with-a-long-random-key

# Path is resolved relative to BmInfra. The default matches the current BM
# sibling layout; change it if your credential file lives elsewhere.
FIREBASE_SERVICE_ACCOUNT_FILE=../brielmarnysos-1dc68-firebase-adminsdk-fbsvc-3e2586a86a.json

# Optional local logging overrides.
# QA_LOG_FORMAT=text
# QA_LOG_LEVEL=DEBUG
# DOCLING_LOG_LEVEL=INFO
# PRICE_AGENT_LOG_LEVEL=INFO

# Optional corporate proxy. Keep Docker service names in NO_PROXY.
# HTTP_PROXY=http://proxy.example:8080
# HTTPS_PROXY=http://proxy.example:8080
# NO_PROXY=localhost,127.0.0.1,postgres,docling-api,price-agent,n8n-qa,backend-qa
